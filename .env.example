# Browser-safe Supabase values. These are public client configuration, not secret keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never place SUPABASE_SERVICE_ROLE_KEY, database passwords, wallet private keys,
# or seed phrases in VITE_* variables or any browser-facing file.
# Server-only integrations must use protected server environment variables.
